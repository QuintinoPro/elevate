# Web App do Apps Script que grava as respostas da peneira.
# Como gerar: AUTOMACOES/PENEIRA/README.md
NEXT_PUBLIC_QUIZ_ENDPOINT=

# Prefixo de caminho. Vazio no domínio próprio, que é o caso desde 14/09/2026.
# Só volta a ser preenchido se o site for servido de um subcaminho de novo.
# NEXT_PUBLIC_BASE_PATH=

# Põe a página no índice do Google. Fora do ambiente, o site sai com noindex.
# NEXT_PUBLIC_INDEXAVEL=1
